{
  "name": "dsh-telegram",
  "description": "Telegram Bot API bridge plugin for DeepSeek Harness: relay private Telegram chats to DSH sessions (long polling, rich messages, inline menus)",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/browser/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-user-questions": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.1-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.1",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "immer": "^10.2.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zustand": "~4.5.7"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.client.json"
  },
  "icon": "./icon.svg"
}
